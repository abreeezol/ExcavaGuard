{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "safety_level": {
      "type": "string",
      "enum": [
        "一级",
        "二级",
        "三级"
      ]
    },
    "support_type": {
      "type": "string",
      "minLength": 1
    },
    "excavation_depth_m": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "post_slab_from": {
      "anyOf": [
        {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "pipeline_type": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "road_type": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "design_values": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "number"
      }
    },
    "danger_signals": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "section_aliases": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "point_sections": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "case_context": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string"
        },
        "soil": {
          "type": "string"
        },
        "stage": {
          "type": "string"
        },
        "groundwater": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "safety_level",
    "support_type",
    "excavation_depth_m"
  ],
  "additionalProperties": false
}
