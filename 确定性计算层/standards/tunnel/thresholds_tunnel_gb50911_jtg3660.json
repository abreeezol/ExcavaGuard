  "cumulative_limit_policy": {
    "rule": "min_of_absolute_and_pct_ref",
    "rule_display": "累计值限值取「绝对量限值」与「比例 × 参照长度」两者的较小值；比例类判据必须声明 cumulative_pct_ref.ref",
    "evidence": "GB 50911-2013 表9.2.2-1（净空收敛 0.2%D）、表9.3.3（管线差异沉降 0.3%Lg 等）",
    "when_ref_unknown": "use_absolute_and_flag",
    "when_ref_unknown_display": "参照长度（D/Ls/Lg）未知时退化为绝对量限值并标记 PCT_REF_NOT_EVALUATED，同时在判定侧按上界弃权处理",
    "note": ""
  },
  "rate_alarm_policy": {
    "rule": "达到控制值 或 速率分级判断",
    "evidence": "JTG/T 3660-2020 第18.6.3条第2款：速率>1.0mm/d 为急剧变形；0.2~1.0mm/d 应加强观测；<0.2mm/d 围岩基本稳定",
    "consecutive_ratio": 0.7,
    "consecutive_count": 3,
    "note": "连续3次超70%的口径沿用本系统既有策略（源自基坑 GB 50497-2019 表8.0.4 注），隧道规范无同等表述；该口径仅在 metric 显式启用时参与，不替代 18.6.3 的速率分级。"
  },
