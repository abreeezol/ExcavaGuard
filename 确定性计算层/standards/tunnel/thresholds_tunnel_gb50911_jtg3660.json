  "description": "隧道施工监测判据库。每一条限值均摘自现行规范条文或表格，并登记规范名称、版本、条文号/表号与适用条件。规范要求「监测项目控制值应由设计文件明确」，本库在无地方经验/无专项方案时按规范给出的表格取值；有设计文件或专项方案时，应按项目上传规范的字段级覆盖处理，不得直接覆盖为更宽松的值。",
  "used_in_stage": "阶段三 · 规范比对",
  "approval_by": "项目团队按规范原文逐条摘录（2026-11-03），条文位置见每条 evidence",
  "selection_policy": {
    "range_resolution": "conservative",
    "range_resolution_display": "区间取严（取区间下限，即较严格值）",
    "range_resolution_options": [
      "conservative",
      "lenient",
      "midpoint"
    ],
    "note": "GB 50911-2013 表9.2.2/9.2.3 给出的是区间值，确定性系统必须取确定值，默认取区间下限。"
