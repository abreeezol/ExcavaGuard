{
  "schema_version": "1.0",
  "source_id": "TUNNEL-PENDING",
  "source_label": "隧道施工监测判据库（测项已定义，限值待规范接入）",
  "source_type": "pending",
  "builtin": false,
  "approval_status": "pending",
  "description": "本文件只登记隧道施工场景的监测项清单与量纲，**不含任何阈值**。限值必须逐条摘自现行规范条文（含规范名称、版本、条文号、表格位置）并经设计方/项目方确认后填入 rules，方可参与判定。在此之前，任何隧道测项在阶段三都会因找不到适用判据而弃权，不会被判为“正常”。",
  "used_in_stage": "阶段三 · 规范比对",
  "selection_policy": {
    "range_resolution": "conservative",
    "range_resolution_display": "区间取严（取区间下限，即较严格值）",
    "note": "与基坑判据库同口径：规范给出区间时取较严格值。"
  },
  "cumulative_limit_policy": {
    "rule": "min_of_absolute_and_pct_ref",
    "rule_display": "累计值限值取「绝对量限值」与「比例 × 参照长度」两者的较小值；比例类判据必须在 rule 中显式声明 cumulative_pct_ref.ref（埋深/跨度/外径）",
    "note": "隧道不宜照搬基坑的 %×开挖深度 H 口径。是否采用比例判据、参照量取埋深还是跨度，须由所依据的规范条文明确。"
  },
  "rate_alarm_policy": {
    "rule": "pending",
    "rule_display": "速率类判据待规范接入",
    "note": "基坑库的「连续 3 次超 70%」出自 GB 50497-2019，不能默认适用于隧道。"
  },
  "danger_alarm_conditions": [],
  "mandatory_alarm_supplement": [],
  "disclaimer": "本判据库为空判据骨架：仅用于确认数据接入、归一化与表式映射链路是否打通，不得用于发布任何预警，也不得据此判定测点安全。",
