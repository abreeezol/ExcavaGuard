{
  "schema_version": "1.0",
  "source_id": "GB50497-2019",
  "source_label": "GB 50497-2019《建筑基坑工程监测技术标准》",
  "source_type": "national_standard",
  "builtin": true,
  "description": "默认规范库阈值文件。数值均取自 GB 50497-2019 表 8.0.4（支护结构预警值）与表 8.0.5（周边环境预警值），并补充 JGJ 120-2012 第 8.2.23 条的报警判据。该文件是阶段三「规范比对」的默认判据来源，用户上传规范时按字段级覆盖本文件的对应条目。",
  "selection_policy": {
    "range_resolution": "conservative",
    "range_resolution_display": "区间取严（取区间下限，即较严格值）",
    "range_resolution_options": [
      "conservative",
      "lenient",
      "midpoint"
    ],
    "note": "GB 50497-2019 表 8.0.4 给出的是供设计方选择的区间。确定性系统必须取确定值，本配置默认取区间下限（偏安全）。可通过导入文件修改 range_resolution。"
  },
  "cumulative_limit_policy": {
    "rule": "min_of_absolute_and_pct_H",
    "rule_display": "累计值取「绝对量限值」与「相对基坑设计深度 H 的限值」两者的较小值",
    "evidence": "GB 50497-2019 表 8.0.4 注",
    "when_H_unknown": "use_absolute_and_flag",
    "when_H_unknown_display": "H 未知时退化为绝对量限值，并在结果中标记 PCT_H_NOT_EVALUATED"
  },
  "rate_alarm_policy": {
    "rule": "达到规定值 或 连续3次超过该值的70%",
    "evidence": "GB 50497-2019 第 8.0.3 条 / 表 8.0.4 注",
    "consecutive_ratio": 0.7,
    "consecutive_count": 3
  },
  "post_slab_policy": {
    "rule": "底板浇筑完成后，位移变化速率不宜超过表中速率预警值的 70%",
    "evidence": "GB 50497-2019 表 8.0.4 注",
    "rate_factor_after_slab": 0.7
  },
