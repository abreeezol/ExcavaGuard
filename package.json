{
  "name": "excavaguard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname localhost",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test",
    "rag:prepare": "node --env-file-if-exists=.env.local tools/rag/pinecone-import.ts",
    "rag:import": "node --env-file-if-exists=.env.local tools/rag/pinecone-import.ts --execute",
    "supabase:check": "node --env-file-if-exists=.env.local tools/supabase/check.ts",
    "supabase:verify": "node --env-file-if-exists=.env.local tools/supabase/check.ts --write-probe --require-ready",
    "supabase:test": "EXCAVAGUARD_TEST_SUPABASE=1 node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run tests/supabase-provider-live.test.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.91",
    "@pinecone-database/pinecone": "9.0.0",
    "@supabase/supabase-js": "2.117.3",
    "ai": "7.0.136",
    "lucide-react": "1.54.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
