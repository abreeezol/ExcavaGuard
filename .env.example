# 无需填写即可启动页面和运行本地测试。全部变量仅用于服务端。
# 复制为 .env.local 后填写；不要提交真实密钥。

# AI 日报模式必填：OpenAI 兼容 chat/completions，需支持结构化 JSON 输出。
# LLM_BASE_URL 填供应商 API 根路径（通常以 /v1 结尾），LLM_MODEL 填可调用的模型 ID。
# 不指定默认供应商；纯计算或显式 template 模式无需 LLM。
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Supabase 公共客户端。publishable key 可以进入浏览器构建，不具备管理权限。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase 服务端。secret key 只能写入 .env.local，禁止 NEXT_PUBLIC_ 前缀。
# 数据库密码不是 API secret key，不写入应用环境变量。
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=excavaguard-private

# Pinecone integrated embedding 索引。运行时查询读取 key/index/namespace/text field。
# 离线创建/导入工具还会读取 cloud、region 和模型；真实密钥只写入 .env.local。
PINECONE_API_KEY=
PINECONE_INDEX=
PINECONE_NAMESPACE=
PINECONE_CLOUD=
PINECONE_REGION=
PINECONE_EMBED_MODEL=multilingual-e5-large
PINECONE_TEXT_FIELD=chunk_text

# 规范证据检索 Provider。Pinecone 文档和查询向量均由索引模型生成。
RAG_PROVIDER=pinecone

# 仅在 RAG_PROVIDER=local 时使用，地址必须是本机 loopback。
# 本地 sidecar 需实现 POST /api/evidence/search 的统一证据 Schema。
LOCAL_RAG_BASE_URL=http://127.0.0.1:8600
LOCAL_RAG_TIMEOUT_MS=10000

# --- 确定性计算引擎（本地 Python）------------------------------------------
# 引擎是 `确定性计算层/pipeline/` 下的纯标准库 Python 代码，由 Node 以子进程调用。
# 不配置时依次尝试 PATH 上的 python3 / python。
# 建议填绝对路径，避免命中错误的解释器。
EXCAVAGUARD_PYTHON=

# 引擎调用超时（毫秒）
EXCAVAGUARD_BRIDGE_TIMEOUT_MS=30000

# 上传文件的存储位置。留空 = <仓库根>/var/uploads
EXCAVAGUARD_UPLOAD_ROOT=

# 存储 provider：local 或 supabase。生产切换必须显式设置并先完成 supabase:test。
EXCAVAGUARD_STORAGE_PROVIDER=local

# 运行记录：留空 = <仓库根>/var/runs。每个 run 保留不可变修订和检查点。
EXCAVAGUARD_RUN_ROOT=

# 单操作者单项目访问。开发期不配密码时仅允许 localhost，并拒绝跨站请求。
# 生产模式必须配置密码（至少 12 字符）和签名密钥（至少 32 字符）。
# 此处不是 Supabase Auth 或多用户项目权限；真实凭证只填 .env.local。
EXCAVAGUARD_ACCESS_PASSWORD=
EXCAVAGUARD_SESSION_SECRET=
EXCAVAGUARD_PROJECT_ID=11111111-1111-4111-8111-111111111111
