# 无需填写即可启动页面和运行本地测试。全部变量仅用于服务端。
# 复制为 .env.local 后填写；不要提交真实密钥。

# 可选的 OpenAI 兼容适配入口。供应商和模型尚未确定，不提供默认模型。
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# 服务端管理客户端；接通业务接口前必须完成用户鉴权和项目权限校验。
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# 使用已创建的索引；当前不会创建索引或写入知识库。
PINECONE_API_KEY=
PINECONE_INDEX=
PINECONE_NAMESPACE=

# 规范证据检索 Provider。pinecone 还需要在服务端显式注入查询 Embedding。
RAG_PROVIDER=pinecone

# 仅在 RAG_PROVIDER=local 时使用，地址必须是本机 loopback。
# 本地 sidecar 需实现 POST /api/evidence/search 的统一证据 Schema。
LOCAL_RAG_BASE_URL=http://127.0.0.1:8600
LOCAL_RAG_TIMEOUT_MS=10000

# --- 确定性计算引擎（本地 Python）------------------------------------------
# 引擎是 `确定性计算层/pipeline/` 下的纯标准库 Python 代码，由 Node 以子进程调用。
# 不配置时依次尝试 PATH 上的 python3 / python。
# 建议填绝对路径，避免命中错误的解释器。
EXCAVAGUARD_PYTHON=

# 引擎调用超时（毫秒）
EXCAVAGUARD_BRIDGE_TIMEOUT_MS=30000

# 上传文件的存储位置。留空 = <仓库根>/var/uploads
EXCAVAGUARD_UPLOAD_ROOT=

# 存储 provider。当前仅实现 local；supabase 需要 bucket 与元数据表，尚未实现。
EXCAVAGUARD_STORAGE_PROVIDER=local
