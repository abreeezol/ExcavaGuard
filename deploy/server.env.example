# Copy to server.env on the SERVER and fill privately. Never put secrets in image.
EXCAVAGUARD_STORAGE_PROVIDER=supabase
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=excavaguard-private
EXCAVAGUARD_PROJECT_ID=11111111-1111-4111-8111-111111111111
EXCAVAGUARD_PROJECT_NAME=试运行工程

# Account directory is initialized by tools/access/manage.mjs.
# For legacy shared-password mode only: password >=12, session secret >=32 chars.
EXCAVAGUARD_ACCESS_PASSWORD=
EXCAVAGUARD_SESSION_SECRET=

RAG_PROVIDER=pinecone
PINECONE_API_KEY=
PINECONE_INDEX=excava-guard
PINECONE_NAMESPACE=standards-v1
PINECONE_TEXT_FIELD=text
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
EXCAVAGUARD_BRIDGE_TIMEOUT_MS=120000

# 项目案例、工况与巡视辅助资料独立目录；需挂载持久卷并备份。
EXCAVAGUARD_PROJECT_CONTEXT_ROOT=

# 专业评价记录目录；同适配器版本、样例哈希绑定，须持久化备份。
EXCAVAGUARD_REVIEW_ROOT=
# 非基坑远端RAG连接别名JSON。盾构本地索引使用适配器local_index，无需此项。
EXCAVAGUARD_RAG_CONNECTIONS=

# 远端知识库发布版本标识；与连接指纹及本次证据一并留痕，不等于全库内容快照。
EXCAVAGUARD_KNOWLEDGE_VERSION=
